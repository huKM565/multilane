#!/sbin/openrc-run
name="multilane-cli"
description="MultiLane tunnel: olcRTC rooms and VPN lines over a tun or a local proxy"
supervisor=supervise-daemon
command=/usr/bin/multilane-cli
command_args="run"
command_user="multilane:multilane"
capabilities="^cap_net_admin,^cap_net_bind_service"
respawn_delay=2
respawn_max=0
output_log="/var/log/multilane-cli.log"
error_log="/var/log/multilane-cli.log"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath -d -m 0750 -o multilane:multilane /run/multilane
	checkpath -d -m 0700 -o multilane:multilane /var/lib/multilane
	checkpath -f -m 0640 -o multilane:multilane /var/log/multilane-cli.log
}
